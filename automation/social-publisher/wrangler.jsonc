{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "watchman-social-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "BRAND_NAME": "La Ultima Vigilia",
    "PUBLIC_MEDIA_BASE_URL": "https://social.laultimavigilia.com/media",
    "AUTO_PUBLISH": "false",
    "ENABLE_FACEBOOK": "false",
    "ENABLE_INSTAGRAM": "true",
    "ENABLE_TIKTOK": "false",
    "META_GRAPH_VERSION": "v26.0",
    "TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-2-klein-4b"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "watchman-social-db",
      "database_id": "fd903df8-aa3b-41c8-99c9-ce752943e59b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "watchman-social-media"
    }
  ],
  "triggers": {
    "crons": [
      "0 14 * * *",
      "0 1 * * *"
    ]
  }
}
