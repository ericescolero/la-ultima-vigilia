{
  "name": "watchman-social-automation",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:remote": "wrangler d1 migrations apply watchman-social-db --remote",
    "db:seed:remote": "wrangler d1 execute watchman-social-db --remote --file=./seeds/0001_watchman_seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.2",
    "wrangler": "^4.131.1"
  }
}
